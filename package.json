{
  "name": "site-lab",
  "version": "0.1.0",
  "private": true,
  "description": "30-site local business design laboratory. Read state.md and memory/PROTOCOL.md before working.",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter site-lab-index dev",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:unit": "pnpm --filter @site-lab/shared test",
    "test:e2e": "pnpm --filter h1-quiet-luxury test:e2e"
  },
  "devDependencies": {
    "create-next-app": "16.3.5"
  }
}
